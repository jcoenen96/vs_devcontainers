// An ASP.NET Core Web API dev container for testing that the app is reachable from the host.
{
  "name": "dotnet-webapi",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",
  // For launches without a launch profile, such as dotnet run --no-launch-profile in the container terminal: listen
  // on every interface inside the container, as the launch profiles do when the extension runs them (their localhost
  // URLs become 0.0.0.0), so the container's address reaches the app and not only the extension's port forwarding.
  "containerEnv": {
    "ASPNETCORE_URLS": "http://0.0.0.0:5080",
    "ASPNETCORE_ENVIRONMENT": "Development"
  },
  // Visual Studio (with the extension) and VS Code forward these ports to localhost while the container runs. The
  // extension also forwards the ports of the launch profile that the Dev Container profile runs (5443 and 5080).
  "forwardPorts": [5080],
  "portsAttributes": {
    "5080": { "label": "HelloApi" }
  },
  "postCreateCommand": "dotnet restore HelloApi.slnx",
  "customizations": {
    "visualstudio": {}
  }
}
