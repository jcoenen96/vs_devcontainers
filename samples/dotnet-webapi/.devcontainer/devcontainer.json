// An ASP.NET Core Web API dev container for testing that the app is reachable from the host.
{
  "name": "dotnet-webapi",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",
  // For launches without a launch profile, such as dotnet run --no-launch-profile in the container terminal: Kestrel
  // has to listen on every interface inside the container, not only on its loopback, or a forwarded port leads
  // nowhere. Launch profiles keep their usual localhost URLs; the extension makes them listen on every interface.
  "containerEnv": {
    "ASPNETCORE_URLS": "http://0.0.0.0:5080",
    "ASPNETCORE_ENVIRONMENT": "Development"
  },
  // Visual Studio (with the extension) and VS Code forward these ports to localhost while the container runs. The
  // extension also forwards the ports of the launch profile that the Dev Container profile runs (5443 and 5080).
  "forwardPorts": [5080],
  "portsAttributes": {
    "5080": { "label": "HelloApi" }
  },
  "postCreateCommand": "dotnet restore HelloApi.slnx",
  "customizations": {
    "visualstudio": {}
  }
}
