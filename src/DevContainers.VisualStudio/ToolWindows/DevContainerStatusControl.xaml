<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">
  <DataTemplate.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </DataTemplate.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="12" Orientation="Vertical">
      <TextBlock Text="{Binding State}" FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" AutomationProperties.Name="Dev container state" />
      <TextBlock Text="{Binding Details}" Margin="0,4,0,8" TextWrapping="Wrap"
                 Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />

      <ItemsControl ItemsSource="{Binding Ports}" Margin="0,0,0,8" AutomationProperties.Name="Forwarded ports">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="0,1">
              <TextBlock Text="{Binding Port}" MinWidth="90" FontFamily="Consolas"
                         Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
              <TextBlock Text="{Binding Address}"
                         Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid Margin="0,0,0,8" Visibility="{Binding HasConfiguration, Converter={StaticResource Visible}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Engine" Margin="0,0,12,0" Foreground="{DynamicResource {x:Static styles:VsBrushes.GrayTextKey}}" />
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Engine}" Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
        <TextBlock Grid.Row="1" Text="Container" Margin="0,0,12,0" Foreground="{DynamicResource {x:Static styles:VsBrushes.GrayTextKey}}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Container}" FontFamily="Consolas" Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
        <TextBlock Grid.Row="2" Text="Configuration" Margin="0,0,12,0" Foreground="{DynamicResource {x:Static styles:VsBrushes.GrayTextKey}}" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Configuration}" TextWrapping="Wrap" Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
      </Grid>

      <WrapPanel Orientation="Horizontal">
        <Button Content="Open in Container" Command="{Binding OpenCommand}" Margin="0,0,6,6" Padding="8,2"
                Visibility="{Binding HasConfiguration, Converter={StaticResource Visible}}" />
        <Button Content="Open Terminal" Command="{Binding TerminalCommand}" Margin="0,0,6,6" Padding="8,2"
                Visibility="{Binding IsRunning, Converter={StaticResource Visible}}" />
        <Button Content="Rebuild" Command="{Binding RebuildCommand}" Margin="0,0,6,6" Padding="8,2"
                Visibility="{Binding HasConfiguration, Converter={StaticResource Visible}}" />
        <Button Content="Stop" Command="{Binding StopCommand}" Margin="0,0,6,6" Padding="8,2"
                Visibility="{Binding IsRunning, Converter={StaticResource Visible}}" />
        <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,6,6" Padding="8,2" />
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</DataTemplate>
