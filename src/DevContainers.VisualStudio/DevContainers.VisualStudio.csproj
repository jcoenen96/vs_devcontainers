<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DevContainers.VisualStudio</RootNamespace>
    <!-- Lets the extension compile (but not package) on Linux and macOS. The VSIX is produced on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Output window and settings APIs are still marked preview in the Extensibility SDK. -->
    <NoWarn>$(NoWarn);VSEXTPREVIEW_OUTPUTWINDOW;VSEXTPREVIEW_SETTINGS</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" />
  </ItemGroup>

  <!--
    MessagePack 2.5.198 comes in through the Extensibility SDK as a compile-time reference only. The SDK excludes
    MessagePack.dll from the VSIX (SuppressFromVsix) and the extension uses the copy that ships with Visual Studio,
    so these advisories are Visual Studio's to patch. Referencing a newer MessagePack here would not change what
    runs and could break assembly binding inside the extension host.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-hv8m-jj95-wg3x" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-vh6j-jc39-fggf" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2f33-pr97-265q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2x83-8g95-xh59" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-cj9g-3mj2-g8vv" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-cxmj-83gh-fp49" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-q2h6-ghwm-5qm8" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-qhmf-xw27-6rqr" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-qhrr-8q5h-9q3h" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v72x-2h86-7f8m" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-w567-gjr2-hm5j" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wfr3-xj75-pfwh" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevContainers.Core\DevContainers.Core.csproj" />
  </ItemGroup>

</Project>
